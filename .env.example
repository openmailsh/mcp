OPENMAIL_API_URL=http://localhost:3000
MCP_RESOURCE_URL=http://localhost:3006
# Must match the API's MCP_JWT_SECRET. Required in production; outside
# production an unset value falls back to NEXTAUTH_SECRET.
MCP_JWT_SECRET=
CONSOLE_ORIGIN=http://localhost:3001
PORT=3006
# PostHog MCP Analytics (same project as the API). Unset = analytics off.
POSTHOG_API_KEY=
MCP_ANALYTICS_DEBUG=
